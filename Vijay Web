<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vijay Website Development | Pune</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Plus+Jakarta+Sans:wght@400;500;700&display=swap" rel="stylesheet">

    <style>
        /* --- 1. CORE VARIABLES --- */
        :root {
            --primary: #FF8E53; /* Orange */
            --secondary: #9B5DE5; /* Purple */
            --whatsapp: #25D366; /* WhatsApp Green */
            --phone: #0f172a; /* Dark Blue for Phone */
            
            --bg-body: #f8fafc;
            --bg-card: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            
            --gradient: linear-gradient(135deg, #9B5DE5 0%, #FF8E53 100%);
            --shadow: 0 10px 30px -10px rgba(0,0,0,0.1);
        }

        [data-theme="dark"] {
            --bg-body: #0f172a;
            --bg-card: #1e293b;
            --text-main: #f1f5f9;
            --text-muted: #94a3b8;
            --border: #334155;
        }

        /* --- 2. GLOBAL RESET --- */
        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            line-height: 1.6;
            transition: all 0.3s ease;
            padding-top: 80px;
        }

        h1, h2, h3 { font-family: 'Outfit', sans-serif; font-weight: 800; }
        a { text-decoration: none; cursor: pointer; }
        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

        /* --- 3. NAVIGATION BAR --- */
        header {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: 80px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
            z-index: 1000;
            display: flex;
            align-items: center;
        }
        [data-theme="dark"] header { background: rgba(15, 23, 42, 0.95); }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        .logo-box { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .logo-img { height: 45px; width: auto; mix-blend-mode: multiply; }
        [data-theme="dark"] .logo-img { mix-blend-mode: normal; border-radius: 6px; }
        
        .brand-name { 
            font-family: 'Outfit', sans-serif; 
            font-weight: 800; 
            font-size: 1.2rem;
            background: var(--gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-links { display: flex; gap: 30px; align-items: center; }
        
        .nav-btn {
            background: none;
            border: none;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 600;
            font-size: 1rem;
            color: var(--text-muted);
            cursor: pointer;
            transition: 0.3s;
            position: relative;
        }
        
        .nav-btn:hover, .nav-btn.active { color: var(--secondary); }
        .nav-btn.active::after {
            content: '';
            position: absolute;
            bottom: -5px; left: 0; right: 0;
            height: 2px;
            background: var(--gradient);
            border-radius: 2px;
        }

        .cta-btn {
            background: var(--gradient);
            color: white;
            padding: 10px 24px;
            border-radius: 50px;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(155, 93, 229, 0.3);
            border: none;
            font-size: 1rem;
            cursor: pointer;
        }
        .cta-btn:hover { transform: translateY(-2px); }

        /* --- 4. SIDEBAR STYLES (NEW) --- */
        .sticky-sidebar {
            position: fixed;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            z-index: 2000;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            color: white;
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
            font-weight: 600;
            transition: transform 0.3s ease, padding 0.3s;
            transform: translateX(calc(100% - 50px)); /* Hide text by default */
            cursor: pointer;
            box-shadow: -2px 5px 15px rgba(0,0,0,0.2);
            width: 180px; /* Fixed width for slide out */
            text-decoration: none;
        }

        .sidebar-item:hover {
            transform: translateX(0); /* Slide out on hover */
        }

        .sidebar-item.whatsapp { background-color: var(--whatsapp); }
        .sidebar-item.phone { background-color: var(--phone); }

        .sidebar-icon {
            font-size: 1.5rem;
            min-width: 25px;
            text-align: center;
            margin-right: 15px;
        }

        /* --- 5. TABS & SECTIONS --- */
        .tab-content { display: none; animation: fadeIn 0.5s ease; }
        .tab-content.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* HERO & SHARED */
        .hero { text-align: center; padding: 60px 0; }
        .hero-logo-large { width: 150px; margin-bottom: 30px; border-radius: 15px; box-shadow: var(--shadow); animation: float 4s ease-in-out infinite; }
        @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

        /* PRICING */
        .pricing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; margin-top: 40px; }
        .plan-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 20px; padding: 40px; position: relative; transition: 0.3s; }
        .plan-card:hover { transform: translateY(-10px); border-color: var(--primary); }
        .plan-card.popular { border: 2px solid var(--secondary); box-shadow: 0 20px 40px rgba(155, 93, 229, 0.15); }
        .ribbon { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--gradient); color: white; padding: 5px 15px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; }
        .price-tag { font-size: 2.5rem; font-weight: 800; font-family: 'Outfit', sans-serif; margin: 15px 0; }
        .feature-list { list-style: none; margin: 25px 0; text-align: left; }
        .feature-list li { margin-bottom: 12px; color: var(--text-muted); display: flex; align-items: center; gap: 10px; }
        .check { color: var(--secondary); font-weight: bold; }

        /* SERVICES */
        .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 25px; margin-top: 30px; }
        .service-box { background: var(--bg-card); padding: 30px; border-radius: 16px; border: 1px solid var(--border); }
        .s-icon { font-size: 2rem; margin-bottom: 15px; display: block; }

        /* CONTACT FORM & ACTIONS */
        .contact-wrapper { max-width: 600px; margin: 0 auto; background: var(--bg-card); padding: 40px; border-radius: 20px; border: 1px solid var(--border); }
        .form-group { margin-bottom: 20px; text-align: left; }
        .form-label { display: block; margin-bottom: 8px; font-weight: 600; font-size: 0.9rem; }
        .form-input { width: 100%; padding: 12px; border-radius: 8px; border: 1px solid var(--border); background: var(--bg-body); color: var(--text-main); font-family: inherit; }
        
        .contact-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 30px; padding-top: 25px; border-top: 1px solid var(--border); }
        .btn-whatsapp { background-color: var(--whatsapp); color: white; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px; border-radius: 8px; font-weight: 700; transition: transform 0.2s; }
        .btn-call { background-color: var(--text-main); color: white; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px; border-radius: 8px; font-weight: 700; transition: transform 0.2s; }
        .btn-whatsapp:hover, .btn-call:hover { transform: translateY(-2px); opacity: 0.9; }

        /* FOOTER */
        footer { margin-top: 80px; padding: 40px 0; background: var(--bg-card); border-top: 1px solid var(--border); text-align: center; }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            .nav-links { position: fixed; bottom: 0; left: 0; right: 0; background: var(--bg-card); padding: 15px; border-top: 1px solid var(--border); justify-content: space-around; z-index: 1000; }
            .cta-btn { display: none; } 
            .nav-call-mobile { display: block; font-weight: bold; color: var(--primary); font-size: 0.9rem; margin-right: 15px;}
            .contact-actions { grid-template-columns: 1fr; }
            body { padding-bottom: 70px; } 
            
            /* Adjust Sidebar for Mobile */
            .sidebar-item { transform: translateX(calc(100% - 45px)); width: 160px; }
            .sidebar-item:active { transform: translateX(0); }
        }
        @media (min-width: 769px) { .nav-call-mobile { display: none; } }
    </style>
</head>
